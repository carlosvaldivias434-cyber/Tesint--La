# ========================================================
# DISCORD BOT CREDENTIALS
# ========================================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
PREFIX=!

# ========================================================
# BLOXLINK SERVER API V4 (TRUSTED OAUTH/MEMBER VERIFICATION)
# Must have Bloxlink bot in guild; never trusts unverified usernames
# ========================================================
BLOXLINK_API_KEY=your_bloxlink_server_api_v4_key_here
BLOXLINK_GUILD_ID=your_guild_id_here

# ========================================================
# AI ENGINES: GROQ (TICKETS ASSISTANT) & SAPLING (APP REVIEW)
# ========================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
SAPLING_API_KEY=your_sapling_api_key_here

